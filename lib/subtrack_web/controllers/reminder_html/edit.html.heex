<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Edit Reminder {@reminder.id}
    <:subtitle>Use this form to manage reminder records in your database.</:subtitle>
  </.header>

  <.reminder_form
    changeset={@changeset}
    action={~p"/subscriptions/#{@subscription}/reminders/#{@reminder}"}
    return_to={~p"/subscriptions/#{@subscription}"}
  />
</Layouts.app>
