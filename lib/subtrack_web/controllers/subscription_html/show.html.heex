<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Subscription {@subscription.id}
    <:subtitle>This is a subscription record from your database.</:subtitle>
    <:actions>
      <.button navigate={~p"/subscriptions"}>
        <.icon name="hero-arrow-left" />
      </.button>
      <.button
        variant="primary"
        navigate={~p"/subscriptions/#{@subscription}/edit?return_to=show"}
      >
        <.icon name="hero-pencil-square" /> Edit subscription
      </.button>
    </:actions>
  </.header>

  <.list>
    <:item title="Platform">{@subscription.name}</:item>
    <:item title="Plan">{@subscription.plan_name}</:item>
    <:item title="Amount">{@subscription.amount}</:item>
    <:item title="Fee amount">{@subscription.fee_amount}</:item>
    <:item title="Charge">
      {money(
        Subtrack.Subscriptions.Subscription.total_amount(@subscription),
        @subscription.currency
      )}
    </:item>
    <:item
      :if={Subtrack.Subscriptions.Subscription.estimated_card_charge(@subscription)}
      title="Estimated card debit"
    >
      ~ {money(
        Subtrack.Subscriptions.Subscription.estimated_card_charge(@subscription),
        @subscription.payment_method.currency
      )} (at {@subscription.fx_rate})
    </:item>
    <:item title="Billing currency">{@subscription.currency}</:item>
    <:item title="Payment Method">{@subscription.payment_method}</:item>
    <:item
      :if={@subscription.fx_rate}
      title="Exchange rate"
    >
      {@subscription.fx_rate}
    </:item>
    <:item title="Billing cycle">{@subscription.billing_cycle}</:item>
    <:item title="Next renewal on">{@subscription.next_renewal_on}</:item>
    <:item title="Status">{@subscription.status}</:item>
    <:item title="Manage url">{@subscription.manage_url}</:item>
    <:item title="Notes">{@subscription.notes}</:item>
  </.list>

  <fieldset class="border border-gray-500 rounded-md p-4">
    <legend class="font-semibold">Reminders</legend>
    <p :if={@reminders == []} class="opacity-30">No reminders yet.</p>
    <ul class="divide divide-y">
      <li :for={r <- @reminders} class="py-2 flex justify-between gap-4">
        <div class={"#{if !r.enabled, do: "opacity-70"} flex flex-col gap-1"}>
          <p class="w-full">{reminder_summary(r)} * {Enum.join(r.channels, ", ")}</p>
          <p :if={String.length(to_string(r.note)) > 0} class="text-xs w-full">- {r.note}</p>
          <p :if={!r.enabled} class="opacity-60 text-sm italic">(disabled)</p>
        </div>

        <span class="space-x-3 text-sm">
          <.link
            href={~p"/subscriptions/#{@subscription}/reminders/#{r}/edit"}
            class="hover:text-primary"
          >Edit</.link>
          <.link
            href={~p"/subscriptions/#{@subscription}/reminders/#{r}"}
            class="hover:text-red-500"
            method="delete"
            data-confirm="Delete this reminder?"
          >Delete</.link>
        </span>
      </li>
    </ul>
  </fieldset>
  <%!-- <.link href={~p"/subscriptions/#{@subscription}/reminders/new"}>Add reminder</.link> --%>
  <.button navigate={~p"/subscriptions/#{@subscription}/reminders/new"}>Add reminder</.button>
</Layouts.app>
