<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Listing Subscriptions
    <:actions>
      <.button href={~p"/subscriptions/new"}>
        <.icon name="hero-plus" /> New Subscription
      </.button>
    </:actions>
  </.header>

  <.table
    id="subscriptions"
    rows={@subscriptions}
    row_click={&JS.navigate(~p"/subscriptions/#{&1}")}
  >
    <:col :let={subscription} label="Platform">{subscription.name}</:col>
    <:col :let={subscription} label="Plan">{subscription.plan_name}</:col>
    <:col :let={subscription} label="Amount">{subscription.amount}</:col>
    <:col :let={subscription} label="Fee / charge">{subscription.fee_amount}</:col>

    <:col :let={subscription} label="Billing currency">{subscription.currency}</:col>
    <:col :let={subscription} label="Exchange rate">{subscription.fx_rate}</:col>
    <:col :let={subscription} label="Billing cycle">
      {Subtrack.Subscriptions.BillingCycles.label(subscription.billing_cycle)}
    </:col>
    <:col :let={subscription} label="Next renewal on">{subscription.next_renewal_on}</:col>
    <:col :let={subscription} label="Status">{subscription.status}</:col>
    <%!-- <:col :let={subscription} label="Manage url">{subscription.manage_url}</:col> --%>
    <%!-- <:col :let={subscription} label="Notes">{subscription.notes}</:col> --%>
    <:action :let={subscription}>
      <div class="sr-only">
        <.link navigate={~p"/subscriptions/#{subscription}"}>Show</.link>
      </div>
      <.link navigate={~p"/subscriptions/#{subscription}/edit"}>Edit</.link>
    </:action>
    <:action :let={subscription}>
      <.link
        href={~p"/subscriptions/#{subscription}"}
        method="delete"
        data-confirm="Are you sure?"
      >
        Delete
      </.link>
    </:action>
  </.table>
</Layouts.app>
