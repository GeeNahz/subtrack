<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    New Payment method
    <:subtitle>Use this form to manage payment_method records in your database.</:subtitle>
  </.header>

  <.payment_method_form changeset={@changeset} action={~p"/payment_methods"} return_to={~p"/payment_methods"} />
</Layouts.app>
