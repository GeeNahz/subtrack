<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Listing Payment methods
    <:actions>
      <.button href={~p"/payment_methods/new"}>
        <.icon name="hero-plus" /> New Payment method
      </.button>
    </:actions>
  </.header>

  <.table
    id="payment_methods"
    rows={@payment_methods}
    row_click={&JS.navigate(~p"/payment_methods/#{&1}")}
  >
    <:col :let={payment_method} label="Nickname">{payment_method.nickname}</:col>
    <:col :let={payment_method} label="Brand">{payment_method.brand}</:col>
    <:col :let={payment_method} label="Card mode">{payment_method.card_mode}</:col>
    <:col :let={payment_method} label="Currency">{payment_method.currency}</:col>
    <:col :let={payment_method} label="Last4">{payment_method.last4}</:col>
    <:col :let={payment_method} label="Bank name">{payment_method.bank_name}</:col>
    <:col :let={payment_method} label="Expiry month">{payment_method.expiry_month}</:col>
    <:col :let={payment_method} label="Expiry year">{payment_method.expiry_year}</:col>
    <:action :let={payment_method}>
      <div class="sr-only">
        <.link navigate={~p"/payment_methods/#{payment_method}"}>Show</.link>
      </div>
      <.link navigate={~p"/payment_methods/#{payment_method}/edit"}>Edit</.link>
    </:action>
    <:action :let={payment_method}>
      <.link
        href={~p"/payment_methods/#{payment_method}"}
        method="delete"
        data-confirm="Are you sure?"
      >
        Delete
      </.link>
    </:action>
  </.table>
</Layouts.app>
